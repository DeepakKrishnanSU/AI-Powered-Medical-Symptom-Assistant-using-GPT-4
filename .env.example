# =============================================================
# Medical Symptom Assistant Configuration Template
# =============================================================

# LLM Provider Selection: 'ollama' or 'openai' (default: 'ollama')
LLM_PROVIDER=ollama

# OpenAI API Configuration (Optional)
# Leave blank to use local Ollama with zero API cost
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama Local Configuration (Running on localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Embeddings Model for Semantic Symptom Extraction
EMBEDDING_MODEL=all-MiniLM-L6-v2
